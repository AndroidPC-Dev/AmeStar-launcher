<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app2="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    app:key=""
    >

    <net.kdt.pojavlaunch.prefs.BackButtonPreference/>

    <PreferenceCategory
        android:title="@string/preference_category_main_categories"
        >


        <Preference
            android:key="st_page_general"
            android:title="General"
            android:summary="How far you see, brightness and presets."
            android:fragment="net.kdt.pojavlaunch.prefs.screens.StarlingSettingsFragment"
            android:icon="@drawable/ic_setting_video"
            >
            <extra android:name="page" android:value="general" />
        </Preference>

        <Preference
            android:key="st_page_display"
            android:title="Display"
            android:summary="Screen orientation, aspect ratio, camera cutout and safe zones."
            android:fragment="net.kdt.pojavlaunch.prefs.screens.StarlingSettingsFragment"
            android:icon="@drawable/ic_setting_video"
            >
            <extra android:name="page" android:value="display" />
        </Preference>

        <Preference
            android:key="st_page_quality"
            android:title="Quality"
            android:summary="The sky and weather, lighting, textures and the image."
            android:fragment="net.kdt.pojavlaunch.prefs.screens.StarlingSettingsFragment"
            android:icon="@drawable/ic_setting_video"
            >
            <extra android:name="page" android:value="quality" />
        </Preference>

        <Preference
            android:key="st_page_performance"
            android:title="Performance"
            android:summary="Chunk loading, culling and power use."
            android:fragment="net.kdt.pojavlaunch.prefs.screens.StarlingSettingsFragment"
            android:icon="@drawable/ic_setting_video"
            >
            <extra android:name="page" android:value="performance" />
        </Preference>

        <Preference
            android:key="st_page_shaders"
            android:title="Shader packs"
            android:summary="Shader packs, Starling Visuals and their options."
            android:fragment="net.kdt.pojavlaunch.prefs.screens.StarlingSettingsFragment"
            android:icon="@drawable/ic_setting_misc"
            >
            <extra android:name="page" android:value="shaders" />
        </Preference>

        <Preference
            android:key="st_page_advanced"
            android:title="Advanced"
            android:summary="How frames reach the screen, and the performance overlay."
            android:fragment="net.kdt.pojavlaunch.prefs.screens.StarlingSettingsFragment"
            android:icon="@drawable/ic_setting_misc"
            >
            <extra android:name="page" android:value="advanced" />
        </Preference>

        <Preference
            android:key="st_page_hdr"
            android:title="HDR"
            android:summary="Brighter-than-white output on an HDR display."
            android:fragment="net.kdt.pojavlaunch.prefs.screens.StarlingSettingsFragment"
            android:icon="@drawable/ic_setting_misc"
            >
            <extra android:name="page" android:value="hdr" />
        </Preference>

        <Preference
            android:key="st_page_extras"
            android:title="Extras"
            android:summary="Optional conveniences. Every one is off by default."
            android:fragment="net.kdt.pojavlaunch.prefs.screens.StarlingSettingsFragment"
            android:icon="@drawable/ic_setting_misc"
            >
            <extra android:name="page" android:value="extras" />
        </Preference>

        <Preference
            android:key="st_page_skin"
            android:title="Skin &amp; name"
            android:summary="Your offline name and skin."
            android:fragment="net.kdt.pojavlaunch.prefs.screens.StarlingSettingsFragment"
            android:icon="@drawable/ic_setting_misc"
            >
            <extra android:name="page" android:value="skin" />
        </Preference>

        <Preference
            android:key="st_page_mods"
            android:title="Mods &amp; content"
            android:summary="Native mods, .hmod content mods and packs."
            android:fragment="net.kdt.pojavlaunch.prefs.screens.StarlingSettingsFragment"
            android:icon="@drawable/ic_setting_misc"
            >
            <extra android:name="page" android:value="mods" />
        </Preference>

        <Preference
            android:key="st_page_diagnostics"
            android:title="Diagnostics &amp; files"
            android:summary="Stats overlay, crash reports, updates and storage."
            android:fragment="net.kdt.pojavlaunch.prefs.screens.StarlingSettingsFragment"
            android:icon="@drawable/ic_setting_misc"
            >
            <extra android:name="page" android:value="diagnostics" />
        </Preference>

        <Preference
            android:key="control_screen_setting"
            android:title="@string/preference_control_title"
            android:summary="@string/preference_control_description"
            android:fragment="net.kdt.pojavlaunch.prefs.screens.LauncherPreferenceControlFragment"
            android:icon="@drawable/ic_menu_custom_controls"
            />

    </PreferenceCategory>

    <SwitchPreference
        android:title="@string/preference_force_english_title"
        android:key="force_english"
        android:summary="@string/preference_force_english_description"
        />

    <Preference
        android:title="@string/preference_ask_for_notification_title"
        android:summary="@string/preference_ask_for_notification_description"
        android:key="notification_permission_request"
        />
    <Preference
        android:title="@string/preference_ask_for_microphone_title"
        android:summary="@string/preference_ask_for_microphone_description"
        android:key="microphone_permission_request"
        />





</PreferenceScreen>